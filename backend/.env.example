# ─────────────────────────────────────────────────────────────────────
# Flowdit Backend — Environment Configuration
# In production, configure the root .env (backend reads from there)
# ─────────────────────────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowdit
DB_USER=flowdit_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — your frontend domain
CORS_ORIGIN=https://yourdomain.com

# Frontend URL — used in email links
FRONTEND_URL=https://yourdomain.com

# SSO (OIDC — per-organization, configured in-app under org settings)
# Encryption key for storing per-org OIDC client secrets — generate with: openssl rand -hex 32
SSO_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_KEY
# This backend's own externally-reachable origin (no trailing slash) — the exact
# redirect URI registered with the identity provider is {PUBLIC_API_URL}/api/auth/sso/callback
PUBLIC_API_URL=https://api.yourdomain.com

# Rate limiting
RATE_LIMIT_MAX=200

# Demo mode — leave unset/false on the real production deploy. Only set to
# true on the demo.flowdit.space instance (see backend/src/db/seed-demo.js).
DEMO_MODE=false

# SMTP (optional — leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flowdit <no-reply@yourdomain.com>
