# ─────────────────────────────────────────────────────────────────────
# Flowdit Backend — Environment Configuration
# In production, configure the root .env (backend reads from there)
# ─────────────────────────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowdit
DB_USER=flowdit_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — your frontend domain
CORS_ORIGIN=https://yourdomain.com

# Frontend URL — used in email links
FRONTEND_URL=https://yourdomain.com

# Rate limiting
RATE_LIMIT_MAX=200

# SMTP (optional — leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flowdit <no-reply@yourdomain.com>
