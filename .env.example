# ─────────────────────────────────────────────────────────────────────
# HackList — Production Environment
# Copy this to .env and fill in ALL values before deploying
# ─────────────────────────────────────────────────────────────────────

# Domains (must point to your VPS IP in DNS before deploying)
FRONTEND_DOMAIN=hacklist.wr0ng.art
API_DOMAIN=api.hacklist.wr0ng.art

# CORS — should match your frontend domain
CORS_ORIGIN=https://hacklist.wr0ng.art

# Let's Encrypt (SSL)
ACME_EMAIL=you@wr0ng.art

# Database
DB_NAME=hacklist
DB_USER=hacklist_user
DB_PASSWORD=CHANGE_THIS

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_128_CHAR_STRING
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_MAX=200

# SMTP — for client portal email notifications (optional)
# Leave SMTP_HOST empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flowdit <no-reply@yourdomain.com>

# Frontend URL — used in email links back to the portal
FRONTEND_URL=https://hacklist.wr0ng.art

