# ─────────────────────────────────────────────────────────────────────
# Flowdit — Environment Configuration
# Copy this to .env and fill in ALL values before deploying
# ─────────────────────────────────────────────────────────────────────

# App
NODE_ENV=production
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowdit
DB_USER=flowdit_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — your frontend domain (comma-separated if multiple)
CORS_ORIGIN=https://yourdomain.com

# Frontend URL — used in email links back to the portal
FRONTEND_URL=https://yourdomain.com

# SSO (OIDC — per-organization, configured in-app under org settings)
# Encryption key for storing per-org OIDC client secrets — generate with: openssl rand -hex 32
SSO_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_KEY
# This backend's own externally-reachable origin (no trailing slash) — the exact
# redirect URI registered with the identity provider is {PUBLIC_API_URL}/api/auth/sso/callback
PUBLIC_API_URL=https://api.yourdomain.com

# Rate limiting
RATE_LIMIT_MAX=200

# Demo mode — leave unset/false on the real production deploy.
# Only set to true on the demo.flowdit.space instance: it blocks the shared
# "demo" login from deleting its own project/org or enabling 2FA (actions
# that would brick the public demo for other visitors until the next
# scheduled reset — see backend/src/db/seed-demo.js). Everything else about
# the demo account stays fully editable.
DEMO_MODE=false

# SMTP — for client portal email notifications (optional)
# Leave SMTP_HOST empty to disable email notifications entirely
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flowdit <no-reply@yourdomain.com>

# AI features (report drafting, AI assistant chat)
# Each project picks its provider in Settings — only fill in the key(s) you plan to use.
# Groq — https://console.groq.com (fast, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic (Claude) — https://console.anthropic.com (pay-per-token, NOT the Claude Pro subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Kimi (Moonshot) — https://platform.moonshot.ai
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
# Custom / local models (Ollama, LM Studio, vLLM...). CUSTOM_API_URL must be an
# OpenAI-compatible chat-completions endpoint, e.g.
#   http://localhost:11434/v1/chat/completions        (Ollama on the host)
#   http://host.docker.internal:11434/v1/chat/completions  (Ollama, backend in Docker)
# Most local servers need no key, so CUSTOM_API_KEY can stay empty.
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Internal URL Puppeteer uses to reach the frontend when rendering PDF reports.
# SECURITY: the PDF endpoint discards the origin the browser sends and rebuilds
# the URL against this value (falling back to FRONTEND_URL) — otherwise the
# renderer could be pointed at internal services and hand back the result as a
# PDF. With neither set, PDF export fails closed.
# In Docker this must be the nginx service, because Puppeteer runs inside the
# backend container where "localhost" is the backend itself, not the frontend.
# Leave empty on a bare-metal install where FRONTEND_URL is already reachable.
INTERNAL_APP_URL=
